# Optional: use a dedicated Ethereum mainnet RPC in production.
NEXT_PUBLIC_ETHEREUM_RPC_URL=

# Optional: override the public Solana endpoints from the official starter.
NEXT_PUBLIC_SOLANA_RPC_URL=
NEXT_PUBLIC_SOLANA_WS_URL=

# During the hackathon this can point to a hosted action manifest.
NEXT_PUBLIC_DEMO_MANIFEST_URL=

# Public canonical origin used in Blink metadata after deployment.
NEXT_PUBLIC_APP_URL=http://localhost:3000
